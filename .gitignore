# Environment variables and secrets
.env*
!.env.example

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo

# Temporary working directories
pages_temp/
images_temp/

# Input and output directories (track only .gitkeep)
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# Operating system files
.DS_Store
Thumbs.db

# Virtual environments
venv/
.venv/

# Legacy configuration
config_local.py
